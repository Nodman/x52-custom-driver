<UserControl x:Class="X52.CustomDriver.App.ThrottleEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="White" FontFamily="Segoe UI Semibold">

    <UserControl.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="120"/>
        </Style>
        <Style x:Key="ParamValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#00D2FF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,15" FontSize="12" Foreground="#888" TextWrapping="Wrap"
                   Text="THROTTLE · deadzones at idle and full travel, and an optional centre band that holds exactly 50% (e.g. a helicopter collective)."/>

        <!-- Graph: x = physical throttle (idle → full), y = what the game gets -->
        <Border Grid.Row="1" Grid.Column="0" Background="#111" CornerRadius="10" Padding="10" VerticalAlignment="Top">
            <StackPanel>
                <Canvas x:Name="GraphCanvas" Width="320" Height="320" Background="#0A0A0A" ClipToBounds="True"/>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="idle   throttle →   full" FontSize="10" Foreground="#555"/>
                    <TextBlock x:Name="LiveText" FontSize="10" FontFamily="Consolas" Foreground="#FF0055" HorizontalAlignment="Right"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Width="10" Height="10" Background="#33FF8800" BorderBrush="#88FF8800" BorderThickness="1" VerticalAlignment="Center"/>
                    <TextBlock Text="end deadzones" FontSize="10" Foreground="#888" Margin="5,0,14,0"/>
                    <Border Width="10" Height="10" Background="#3300D2FF" BorderBrush="#8800D2FF" BorderThickness="1" VerticalAlignment="Center"/>
                    <TextBlock Text="centre band (50%)" FontSize="10" Foreground="#888" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#111" CornerRadius="10" Padding="15" Margin="15,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="IDLE DEADZONE" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding Value, ElementName=LowerSlider, StringFormat={}{0:N0}%}" Style="{StaticResource ParamValue}"/>
                    <Slider x:Name="LowerSlider" Minimum="0" Maximum="40" SmallChange="1" LargeChange="5" ValueChanged="Slider_Changed"
                            ToolTip="Travel at the idle end that still counts as 0% (makes idle really idle)"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="FULL DEADZONE" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding Value, ElementName=UpperSlider, StringFormat={}{0:N0}%}" Style="{StaticResource ParamValue}"/>
                    <Slider x:Name="UpperSlider" Minimum="0" Maximum="40" SmallChange="1" LargeChange="5" ValueChanged="Slider_Changed"
                            ToolTip="Travel at the full end that already counts as 100% (so the game reliably sees full throttle)"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="CENTRE DEADZONE" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding Value, ElementName=CenterSlider, StringFormat={}{0:N0}%}" Style="{StaticResource ParamValue}"/>
                    <Slider x:Name="CenterSlider" Minimum="0" Maximum="40" SmallChange="1" LargeChange="5" ValueChanged="Slider_Changed"
                            ToolTip="Width of a band that always sends exactly 50%. 0 = off."/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8" x:Name="CenterPositionRow">
                    <TextBlock Text="CENTRE POSITION" Style="{StaticResource ParamLabel}"/>
                    <TextBlock Text="{Binding Value, ElementName=CenterPosSlider, StringFormat={}{0:N0}%}" Style="{StaticResource ParamValue}"/>
                    <Slider x:Name="CenterPosSlider" Minimum="10" Maximum="90" SmallChange="1" LargeChange="5" ValueChanged="Slider_Changed"
                            ToolTip="Where the centre band sits on the throttle travel"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="120,0,0,16" x:Name="CenterButtonsRow">
                    <Button x:Name="SetCenterButton" Content="SET CENTRE HERE" Padding="8,5" Background="#222" Foreground="#00D2FF"
                            BorderBrush="#00D2FF" BorderThickness="1" Margin="0,0,8,0" Click="SetCenter_Click"
                            ToolTip="Put the throttle where you want the 50% point (e.g. hover) and click"/>
                    <Button Content="50%" Padding="8,5" Background="#222" Foreground="#888" BorderBrush="#444" BorderThickness="1"
                            Click="CenterDefault_Click" ToolTip="Centre back in the middle of the travel"/>
                </StackPanel>

                <CheckBox x:Name="InvertBox" Content="Invert axis" Foreground="White" Margin="0,0,0,20" Checked="Invert_Changed" Unchecked="Invert_Changed"/>

                <Button Content="RESET" Padding="8" Background="#222" Foreground="#FF5555" BorderBrush="#FF5555" BorderThickness="1" Click="Reset_Click"
                        ToolTip="No deadzones, centre at 50%, not inverted"/>

                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555" Margin="0,20,0,0"
                           Text="Each profile has its own throttle settings. If this profile is the active one, changes apply instantly. The red dot is your throttle right now."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
