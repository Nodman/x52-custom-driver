<UserControl x:Class="X52.CustomDriver.App.ProfilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:X52.CustomDriver.App"
    Foreground="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Profile list -->
        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock DockPanel.Dock="Top" Text="PROFILES" FontWeight="Bold" Foreground="{StaticResource NeonBlue}" FontSize="16" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" x:Name="ActiveProfileText" FontSize="11" Foreground="#888" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button Content="+ NEW PROFILE" Style="{StaticResource NeonButton}" Padding="10" Click="NewProfile_Click"/>
                <UniformGrid Columns="2" Margin="0,8,0,0">
                    <Button Content="DUPLICATE" Style="{StaticResource NeonButton}" Margin="0,0,4,0" Click="DuplicateProfile_Click"
                            ToolTip="Copy this profile with all its mappings, curves and mouse settings"/>
                    <Button x:Name="DeleteProfileButton" Content="DELETE" Style="{StaticResource DangerButton}" Margin="4,0,0,0" Click="DeleteProfile_Click"/>
                </UniformGrid>
            </StackPanel>

            <ListBox x:Name="ProfilesList" Background="#0A0A0A" Foreground="White" BorderThickness="0" SelectionChanged="ProfilesList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="10,9">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#151515"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#002233"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#00D2FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14"/>
                            <TextBlock Text="{Binding ProcessName}" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Selected profile -->
        <Grid Grid.Column="1" x:Name="EditorArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="PROFILE NAME" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource MacroRecordingTextBox}" Height="32" LostFocus="NameBox_LostFocus" KeyDown="NameBox_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="GAME .EXE (switches to this profile automatically)" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="ProcessBox" Style="{StaticResource MacroRecordingTextBox}" Height="32"
                             Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. DCS or DCS.exe, FlightSimulator, StarCitizen"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="MakeActiveButton" Content="MAKE ACTIVE" Style="{StaticResource NeonButton}"
                        Height="32" MinWidth="120" Margin="10,0,0,0" VerticalAlignment="Bottom" Click="MakeActive_Click"
                        ToolTip="Use this profile now. It stays until a game with its own profile starts or closes."/>
            </Grid>

            <TabControl Grid.Row="1" Margin="0,15,0,0">
                <!-- Button mappings -->
                <TabItem Header="BUTTON MAPPINGS">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Stick button → keyboard keys. Click the keys cell and press the combination; click Action to choose Hold, Tap or Toggle." VerticalAlignment="Center" FontSize="11" Foreground="#666" TextWrapping="Wrap" Width="360"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="REMOVE SELECTED" Style="{StaticResource DangerButton}" Margin="0,0,10,0" Click="RemoveMapping_Click"/>
                                <Button Content="+ ADD MAPPING" Style="{StaticResource NeonButton}" Click="AddMapping_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid x:Name="MappingsGrid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" CellEditEnding="MappingsGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Mode" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mode, Converter={StaticResource ModeConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#AAA" FontSize="13"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Mode}" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:ProfilesView}, Path=AvailableModes}" Style="{StaticResource ExtremeVisibilityComboBox}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="X52 Button" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ButtonName}" VerticalAlignment="Center" Padding="15,0" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding ButtonName}" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:ProfilesView}, Path=AvailableButtons}" Style="{StaticResource ExtremeVisibilityComboBox}" IsDropDownOpen="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Keyboard keys (click &amp; press)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding KeySequenceString}" Padding="15,0" VerticalAlignment="Center" Foreground="{StaticResource NeonBlue}" FontSize="14"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding KeySequenceString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MacroRecordingTextBox}" PreviewKeyDown="MacroBox_PreviewKeyDown"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="95">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Action" ToolTip="Hold: keys held while the button is held. Tap: one short press. Toggle: press once to hold, again to release."/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Action}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#AAA" FontSize="13"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Action}" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:ProfilesView}, Path=AvailableActions}" Style="{StaticResource ExtremeVisibilityComboBox}" IsDropDownOpen="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridCheckBoxColumn Header="vJoy" Binding="{Binding EnableVJoy}" Width="60">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Axis curves -->
                <TabItem Header="AXIS CURVES">
                    <local:CurveEditorView x:Name="CurveEditor"/>
                </TabItem>

                <!-- Thumb stick mouse -->
                <TabItem Header="THUMB STICK MOUSE">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border x:Name="MousePanel" Style="{StaticResource Card}" HorizontalAlignment="Left" Width="460" VerticalAlignment="Top">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding Enabled}" Content="Thumb stick moves the cursor" Style="{StaticResource NeonCheckBox}" Margin="0,0,0,10"/>
                                <CheckBox IsChecked="{Binding Buttons}" Content="Mouse buttons and scroll" Style="{StaticResource NeonCheckBox}" Margin="0,0,0,18"
                                          ToolTip="Throttle mouse button = left click, wheel press = middle click, scroll = wheel"/>
                                <DockPanel Margin="0,0,0,15">
                                    <TextBlock Text="SPEED" VerticalAlignment="Center" FontSize="11" Foreground="#888" Width="80"/>
                                    <TextBlock Text="{Binding Speed, StringFormat=N0}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Foreground="#00D2FF" Margin="10,0,0,0" Width="40" TextAlignment="Right"/>
                                    <Slider Minimum="100" Maximum="4000" SmallChange="50" LargeChange="250" Value="{Binding Speed}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <TextBlock Text="DEADZONE" VerticalAlignment="Center" FontSize="11" Foreground="#888" Width="80"/>
                                    <TextBlock Text="{Binding Deadzone, StringFormat=N1}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Foreground="#00D2FF" Margin="10,0,0,0" Width="40" TextAlignment="Right"/>
                                    <Slider Minimum="0" Maximum="4" SmallChange="0.1" LargeChange="0.5" Value="{Binding Deadzone}" VerticalAlignment="Center"
                                            ToolTip="Raise this if the cursor drifts on its own (worn thumb stick)"/>
                                </DockPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666"
                                           Text="Ctrl+Alt+M switches the thumb stick mouse of the active profile on/off from anywhere. Rotation and invert are in SETTINGS, because they depend on the stick, not the game."/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
