<Window x:Class="X52.CustomDriver.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:X52.CustomDriver.App" mc:Ignorable="d" Title="Ærakon x52 driver" Height="720" Width="1080" ResizeMode="CanResizeWithGrip" WindowStyle="SingleBorderWindow" Background="#050505" Foreground="White" FontFamily="Segoe UI Semibold">

    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Message bar: recovered files, save errors -->
        <Border Grid.Row="0" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#0D2A33"/>
                    <Setter Property="BorderBrush" Value="#00D2FF"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                            <Setter Property="Background" Value="#3A0010"/>
                            <Setter Property="BorderBrush" Value="#FF5555"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Background="Transparent" Foreground="#AAA" BorderThickness="0" Padding="8,0"
                        VerticalAlignment="Top" Click="DismissBanner_Click" ToolTip="Hide this message"/>
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Foreground="White" FontSize="12"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="LIVE">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TitleText" Text="Ærakon x52 driver" FontSize="20" FontWeight="Bold" Foreground="#00D2FF" Margin="0,0,0,20"/>

                        <TextBlock Text="PRIMARY AXES" FontWeight="Bold" Margin="0,10,0,10" Foreground="#555"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Top-down stick position: physical vs. after curves -->
                            <local:StickPositionView x:Name="StickView" Grid.Column="0" Margin="0,0,20,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="X AXIS (Aileron)" Style="{StaticResource AxisLabel}" Margin="0,0,0,2"/>
                                <ProgressBar Style="{StaticResource NeonProgressBar}" Value="{Binding XPercent, Mode=OneWay}"/>

                                <TextBlock Text="Y AXIS (Elevator)" Style="{StaticResource AxisLabel}"/>
                                <ProgressBar Style="{StaticResource NeonProgressBar}" Value="{Binding YPercent, Mode=OneWay}"/>

                                <TextBlock Text="Z AXIS (Rudder)" Style="{StaticResource AxisLabel}"/>
                                <ProgressBar Style="{StaticResource NeonProgressBar}" Value="{Binding ZPercent, Mode=OneWay}"/>

                                <local:PovView x:Name="PovIndicator" Margin="0,22,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="THROTTLE &amp; AUX" FontWeight="Bold" Margin="0,30,0,10" Foreground="#555"/>

                        <TextBlock Text="THROTTLE" Style="{StaticResource AxisLabel}"/>
                        <ProgressBar Style="{StaticResource NeonProgressBar}" Value="{Binding ThrottlePercent, Mode=OneWay}" Foreground="#FF0055"/>

                        <TextBlock Text="SLIDER" Style="{StaticResource AxisLabel}"/>
                        <ProgressBar Style="{StaticResource NeonProgressBar}" Value="{Binding SliderPercent, Mode=OneWay}"/>

                        <UniformGrid Columns="2" Margin="0,20,0,0">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="ROTARY 1" Style="{StaticResource AxisLabel}"/>
                                <ProgressBar Style="{StaticResource NeonProgressBar}" Value="{Binding Rotary1Percent, Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="ROTARY 2" Style="{StaticResource AxisLabel}"/>
                                <ProgressBar Style="{StaticResource NeonProgressBar}" Value="{Binding Rotary2Percent, Mode=OneWay}"/>
                            </StackPanel>
                        </UniformGrid>

                        <DockPanel Margin="0,30,0,10">
                            <TextBlock Text="{Binding ButtonBankText}" DockPanel.Dock="Right" FontSize="11" Foreground="#00D2FF" VerticalAlignment="Bottom"/>
                            <TextBlock Text="BUTTONS" FontWeight="Bold" Foreground="#555"/>
                        </DockPanel>
                        <Border Background="#111" CornerRadius="10" Padding="10">
                            <ItemsControl ItemsSource="{Binding PhysicalButtons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="3" Padding="8,5" CornerRadius="4" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#0A0A0A"/>
                                                    <Setter Property="BorderBrush" Value="#222"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                            <Setter Property="Background" Value="#3A0010"/>
                                                            <Setter Property="BorderBrush" Value="#FF0055"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#333"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                                    <Setter Property="Fill" Value="#FF0055"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#AAA"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="MODE SELECTOR" FontWeight="Bold" Margin="0,30,0,10" Foreground="#555"/>
                        <!-- Same colours as the LED on the stick: green, orange, red -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,0,0,0">
                            <StackPanel Margin="0,0,24,0">
                                <Border Width="70" Height="10" Background="#1a1a1a" CornerRadius="5">
                                    <Border CornerRadius="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMode1}" Value="True">
                                                        <Setter Property="Background" Value="#00E676"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#00E676" BlurRadius="12" ShadowDepth="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Border>
                                <TextBlock Text="MODE 1" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMode1}" Value="True">
                                                    <Setter Property="Foreground" Value="#00E676"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <Border Width="70" Height="10" Background="#1a1a1a" CornerRadius="5">
                                    <Border CornerRadius="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMode2}" Value="True">
                                                        <Setter Property="Background" Value="#FF9100"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#FF9100" BlurRadius="12" ShadowDepth="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Border>
                                <TextBlock Text="MODE 2" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMode2}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF9100"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0">
                                <Border Width="70" Height="10" Background="#1a1a1a" CornerRadius="5">
                                    <Border CornerRadius="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMode3}" Value="True">
                                                        <Setter Property="Background" Value="#FF1744"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#FF1744" BlurRadius="12" ShadowDepth="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Border>
                                <TextBlock Text="MODE 3" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMode3}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF1744"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                        <!-- Right column: status -->
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <Border Background="#111" CornerRadius="10" Padding="15">
                            <StackPanel>
                                <TextBlock Text="CONNECTION STATUS" FontSize="14" Foreground="#555" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Red"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#00FF88"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="X52 Hardware" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Red"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVJoyActive}" Value="True">
                                                        <Setter Property="Fill" Value="#00FF88"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding VJoyDeviceName}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HideRealX52Status}" FontSize="10" Foreground="#666" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource SectionHeader}"/>
                        <ComboBox x:Name="ActiveProfileCombo" Height="36" FontWeight="Bold" Foreground="#00D2FF"
                                  Style="{StaticResource ExtremeVisibilityComboBox}"
                                  ItemsSource="{Binding Profiles, Mode=OneWay}"
                                  SelectedItem="{Binding ActiveProfileSelection, Mode=TwoWay}"
                                  DropDownOpened="ActiveProfileCombo_DropDownOpened">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Pick one to switch now. Starting or closing a game with its own profile switches automatically." FontSize="10" Foreground="#555" Margin="0,5,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="THUMB STICK MOUSE" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding NubMouseStatus}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="#00D2FF"/>
                                    <TextBlock Text="Ctrl+Alt+M to toggle" FontSize="11" Foreground="#888"/>
                                </DockPanel>
                                <TextBlock Text="{Binding NubDisplay}" FontSize="11" FontFamily="Consolas" Foreground="#555" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="KEY MAPPINGS" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}">
                            <TextBlock Text="{Binding MappingActivityText}" FontSize="12" FontFamily="Consolas" Foreground="#00D2FF" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="CALIBRATION" FontWeight="Bold" Margin="0,25,0,10" Foreground="#555"/>
                        <UniformGrid Columns="2">
                            <Button Content="SET CENTER" Margin="0,0,5,0" Padding="8" Background="#222" Foreground="#00D2FF" BorderBrush="#00D2FF" BorderThickness="1" Click="CalibrateCenter_Click" ToolTip="Fixes current stick position as neutral center"/>
                            <Button Content="RESET ALL" Margin="5,0,0,0" Padding="8" Background="#222" Foreground="#FF5555" BorderBrush="#FF5555" BorderThickness="1" Click="ResetCalibration_Click" ToolTip="Resets learned axis limits and centers"/>
                        </UniformGrid>

                        <Border Background="#111" CornerRadius="10" Padding="15" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="HID DEBUG (Raw Bytes)" FontSize="10" Foreground="#444" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding RawDataString}" FontSize="11" FontFamily="Consolas" Foreground="#00D2FF" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="PROFILES">
                <local:ProfilesView x:Name="ProfilesTab"/>
            </TabItem>

            <TabItem Header="SETTINGS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="HIDE REAL X52 FROM GAMES" Style="{StaticResource SectionHeader}" Margin="0,5,0,10"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Without this, games see two joysticks: the real X52 and the Ærakon virtual stick, so every input arrives twice. HidHide hides the real X52 from every program except this driver."/>
                                <TextBlock Text="{Binding HideRealX52Status}" FontSize="12" Foreground="#00D2FF" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="HideX52Button" Content="HIDE REAL X52" Style="{StaticResource NeonButton}" Margin="0,0,10,8" Click="HideX52_Click"
                                            ToolTip="Windows will ask for admin permission once"/>
                                    <Button x:Name="ShowX52Button" Content="SHOW IT AGAIN" Style="{StaticResource DangerButton}" Margin="0,0,10,8" Click="ShowX52_Click"/>
                                    <Button x:Name="GetHidHideButton" Content="GET HIDHIDE" Style="{StaticResource NeonButton}" Margin="0,0,10,8" Click="GetHidHide_Click"
                                            ToolTip="Opens the official HidHide download page (free, by Nefarius)"/>
                                </WrapPanel>
                                <TextBlock x:Name="HideX52Message" FontSize="11" Foreground="#FF5555" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="VIRTUAL JOYSTICK (vJoy)" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding VJoyInfoText}" FontSize="12" Foreground="#00D2FF" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <CheckBox IsChecked="{Binding ModeShiftsButtons}" Style="{StaticResource NeonCheckBox}" Margin="0,0,0,6"
                                          Content="Mode dial shifts buttons (mode 1 = 1–32, mode 2 = 33–64, mode 3 = 65–96)"/>
                                <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="26,0,0,12"
                                           Text="Off: every mode uses buttons 1–31. The stick-top hat is POV 1. Windows' Game Controllers window only shows the first 32 buttons."/>
                                <WrapPanel>
                                    <Button x:Name="SetUpVJoyButton" Content="SET UP VJOY" Style="{StaticResource NeonButton}" Margin="0,0,10,8" Click="SetUpVJoy_Click"
                                            ToolTip="Sets vJoy device 1 to 8 axes, 128 buttons and 1 continuous POV hat (asks for admin permission once)"/>
                                    <Button Content="OPEN GAME CONTROLLERS" Style="{StaticResource NeonButton}" Margin="0,0,10,8" Click="OpenJoyCpl_Click"
                                            ToolTip="Opens joy.cpl to test the virtual stick"/>
                                    <Button Content="CONFIGURE VJOY" Style="{StaticResource NeonButton}" Margin="0,0,10,8" Click="OpenVJoyConf_Click"
                                            ToolTip="Set the number of buttons and POV hats of vJoy device 1"/>
                                    <Button Content="VJOY MONITOR" Style="{StaticResource NeonButton}" Margin="0,0,10,8" Click="OpenVJoyMonitor_Click"
                                            ToolTip="vJoy's own monitor: shows all axes, 128 buttons and POV hats of the virtual stick"/>
                                </WrapPanel>
                                <TextBlock x:Name="VJoyMessage" FontSize="11" Foreground="#FF5555" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SYSTEM" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding RunAtStartup}" Content="Run at Windows startup" Style="{StaticResource NeonCheckBox}" Margin="0,0,0,10"/>
                                <CheckBox IsChecked="{Binding MinimizeToTray}" Content="Minimize to tray" Style="{StaticResource NeonCheckBox}" Margin="0,0,0,10"/>
                                <CheckBox IsChecked="{Binding CloseToTray}" Content="Close to tray (keep running in the background)" Style="{StaticResource NeonCheckBox}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="THUMB STICK ORIENTATION" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Fix the cursor direction if the thumb stick reports turned or mirrored. Applies to every profile." FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="ROTATION" VerticalAlignment="Center" FontSize="11" Foreground="#888" Width="80"/>
                                    <Button Content="ROTATE 90°" DockPanel.Dock="Right" Style="{StaticResource NeonButton}" Click="RotateNub_Click"
                                            ToolTip="Turns the cursor direction 90° clockwise each click"/>
                                    <TextBlock Text="{Binding NubRotationText}" VerticalAlignment="Center" FontSize="11" Foreground="#00D2FF"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox IsChecked="{Binding NubMouseInvertX}" Content="Invert X" Style="{StaticResource NeonCheckBox}" Margin="0,0,25,0"/>
                                    <CheckBox IsChecked="{Binding NubMouseInvertY}" Content="Invert Y" Style="{StaticResource NeonCheckBox}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding NubDisplay}" FontSize="11" FontFamily="Consolas" Foreground="#555"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource Card}">
                            <TextBlock FontSize="12" Foreground="#AAA" TextWrapping="Wrap"
                                       Text="Ctrl+Alt+M  –  switch the thumb stick mouse of the active profile on/off (works even when this window is hidden)."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
